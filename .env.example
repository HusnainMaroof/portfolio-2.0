# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# On Vercel, add the same four variables under Project > Settings >
# Environment Variables.

# --- Neon (Postgres) -------------------------------------------------------
# Neon dashboard > your project > Connect. Copy both connection strings.
# Then edit both: REMOVE "&channel_binding=require" (Prisma's engine can't
# always connect with it; TLS stays on through sslmode=require) and ADD
# "&connect_timeout=15" (gives a sleeping free-tier database time to wake).

# Pooled connection: the host contains "-pooler". Used by the site.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Direct connection: same string WITHOUT "-pooler". Used only to create the
# tables (`pnpm db:push`).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# --- Secret admin page (/admin) -------------------------------------------
# The password for the visitor dashboard. Server-side only: it is never sent
# to the browser.
ADMIN_PASSWORD="choose-a-strong-password"

# Signs the admin login cookie. Any long random string, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET="replace-with-64-random-hex-characters"
