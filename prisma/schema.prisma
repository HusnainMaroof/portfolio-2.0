// Visitor analytics, live presence and star ratings for the portfolio.
// Database: Neon (Postgres). See .env.example for the connection strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (Neon "-pooler" host): used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct connection: used by `prisma db push` / migrations only.
  directUrl = env("DIRECT_URL")
}

/// One page view. No IP address is stored: a visitor is an anonymous random
/// id kept in a first-party cookie, and location is the country/city the
/// hosting edge reports.
model Visit {
  id         String   @id @default(cuid())
  visitorId  String
  /// Keyed hash of the visitor's IP (HMAC with ADMIN_SECRET). Lets the same
  /// person count once even with a new browser or cleared cookies; it can't
  /// be turned back into the IP without the secret.
  ipHash     String?
  path       String
  referrer   String?
  /// Tracking-link tag, from ?ref= or ?utm_source= (e.g. "acme-recruiter").
  source     String?
  /// Network owner of the visitor's IP (e.g. "Microsoft Corporation"),
  /// looked up once per visit. The IP itself is never stored.
  org        String?
  /// "company", "isp" (home/mobile internet) or "hosting" (cloud/VPN).
  orgType    String?
  country    String?
  city       String?
  device     String?
  browser    String?
  os         String?
  /// Time spent on the page, updated by the heartbeat while it is open.
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId])
  @@index([ipHash])
}

/// Who has the site open right now: one row per visitor, refreshed by the
/// heartbeat. "Online" = seen in the last minute.
model Presence {
  visitorId String   @id
  path      String
  lastSeen  DateTime @default(now())

  @@index([lastSeen])
}

/// One star rating (1-5) per visitor; rating again replaces it.
model Rating {
  visitorId String   @id
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A note a visitor left on the footer's notes wall. Shown publicly only
/// once approved in /admin.
model Note {
  id        String   @id @default(cuid())
  /// Optional display name; empty shows as "Anonymous".
  name      String?
  message   String
  /// Sticky-note colour key (see NOTE_COLORS).
  color     String   @default("lime")
  /// "pending" (waiting for approval), "approved" (on the wall) or "hidden".
  status    String   @default("pending")
  /// Why a note was held back automatically, e.g. "contains a link".
  flag      String?
  visitorId String
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([ipHash])
  @@index([visitorId])
}
