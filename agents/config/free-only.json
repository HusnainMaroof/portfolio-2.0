    "claude": {
      "enabled": false
    },
    "codex": {
      "enabled": false
    },
    "openai": {
      "enabled": false
    }
  },
  "router": {
    "premium": "never"
  },
  "senior": {
    "model": "openhands:opencode/opencode/deepseek-v4.1-flash-free",
    "fallback": [
      "kilo:kilo/reflection/beam-free",
      "opencode:opencode/glm-5.3-flash-free"
    ]
  }
}
